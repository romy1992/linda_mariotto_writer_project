VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Facoltativo: "true" per collegare le Cloud Functions all'emulatore locale
# (richiede `firebase emulators:start --only functions` in parallelo)
VITE_USE_FUNCTIONS_EMULATOR=

# Facoltativo: "true" per usare Firestore locale sulla porta 8080
VITE_USE_FIRESTORE_EMULATOR=
