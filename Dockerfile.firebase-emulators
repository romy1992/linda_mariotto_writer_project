FROM node:20-trixie-slim

ARG FIREBASE_TOOLS_VERSION=15.28.1

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      ca-certificates \
      openjdk-21-jre-headless \
    && rm -rf /var/lib/apt/lists/* \
    && npm install --global "firebase-tools@${FIREBASE_TOOLS_VERSION}" \
    && firebase --version

WORKDIR /workspace

COPY docker/firebase-emulators-entrypoint.sh /usr/local/bin/firebase-emulators-entrypoint
RUN chmod +x /usr/local/bin/firebase-emulators-entrypoint

EXPOSE 4000 4400 4500 5001 8080 9099 9150 9199

ENTRYPOINT ["firebase-emulators-entrypoint"]
